{
  "name": "aitdroid-coop-server",
  "version": "0.1.0",
  "description": "Lightweight WebSocket server for the AITDroid co-op prototype (sessions, character assignment, start agreement, state relay)",
  "private": true,
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsc -p tsconfig.json && node dist/src/index.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.2"
  }
}
